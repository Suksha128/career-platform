# ============================================================
# .env.example — Copy this to .env and fill in your keys
# ============================================================

# ── REQUIRED: Hugging Face API Token ───────────────────────
# Get free token at: https://huggingface.co/settings/tokens
# Select "Read" access when creating the token.
HF_API_TOKEN=hf_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ── PRIMARY MODEL (Recommended) ────────────────────────────
# Qwen2.5-7B-Instruct: Best for structured JSON, code, technical Q&A
HF_MODEL_ID=Qwen/Qwen2.5-7B-Instruct

# ── BACKUP MODEL (Alternative) ─────────────────────────────
# Uncomment below to use Llama-3 instead
# HF_MODEL_ID=meta-llama/Meta-Llama-3-8B-Instruct

# ── OPTIONAL: SerpAPI for live web recruitment search ──────
# Get free key (100 searches/month) at: https://serpapi.com
# Leave blank to use DuckDuckGo (free, no key needed)
SERPAPI_KEY=

# ── OPTIONAL: Gemini fallback (if HF quota exceeded) ───────
GEMINI_API_KEY=

# ── Server Config ───────────────────────────────────────────
PORT=8000
HOST=0.0.0.0
